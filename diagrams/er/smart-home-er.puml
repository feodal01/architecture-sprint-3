@startuml

entity Пользователь {
  + id: UUID [PK]
  + имя: String
  + email: String
  + пароль: String
}

entity Дом {
  + id: UUID [PK]
  + пользователь_id: UUID [FK]
  + адрес: String
  + название: String
}

entity Устройство {
  + id: UUID [PK]
  + тип_id: UUID [FK]
  + дом_id: UUID [FK]
  + серийный_номер: String
  + статус: String
}

entity ТипУстройства {
  + id: UUID [PK]
  + название: String
  + описание: String
}

entity Модуль {
  + id: UUID [PK]
  + название: String
  + описание: String
}

entity Телеметрия {
  + id: UUID [PK]
  + устройство_id: UUID [FK]
  + временная_метка: DateTime
  + данные: JSON
}

entity ПользовательДом {
  + пользователь_id: UUID [PK, FK]
  + дом_id: UUID [PK, FK]
  + уровень_доступа: String
}

entity УстройствоМодуль {
  + устройство_id: UUID [PK, FK]
  + модуль_id: UUID [PK, FK]
}

Пользователь ||--o{ ПользовательДом : владеет
Дом ||--o{ ПользовательДом : доступ_к
Дом ||--o{ Устройство : содержит
Устройство ||--o{ Телеметрия : генерирует
Устройство ||--o{ УстройствоМодуль : имеет
Модуль ||--o{ УстройствоМодуль : связано_с
ТипУстройства ||--|{ Устройство : классифицируется_как

@enduml
